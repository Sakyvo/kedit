{
  "manifest_version": 3,
  "name": "KEDIT 文件夹路径粘贴",
  "version": "1.0.0",
  "description": "仅在 KEDIT 粘贴时读取 Windows 文件夹完整路径，不修改剪贴板。",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kedit.cc.cd/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "key": ""
}
